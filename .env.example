# R & Go — Optional Live API Credentials
# The app runs out-of-the-box in Hybrid Mode with rich San Francisco demo fixtures,
# hosted official event agenda pages, and interactive vector/tile maps.

# Gemini API Key (for live Argon evidence extraction & conflict analysis)
GEMINI_API_KEY=
# Model identifier (defaults to gemini-2.5-flash if not overridden; set to your hackathon Argon model ID if provided)
GEMINI_MODEL_ID=gemini-2.5-flash

# Google Maps API Key (optional: enables live Google Routes API & Maps JS)
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Calendar OAuth / API (optional: enables live Google Calendar read/sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ACCESS_TOKEN=
